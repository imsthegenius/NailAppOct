{
  "cli": {
    "version": ">= 8.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "cache": {
        "key": "pods-${hash:ios/Podfile.lock}"
      },
      "ios": {
        "resourceClass": "m-medium",
        "image": "sdk-53"
      },
      "channel": "preview"
    },
    "payments": {
      "distribution": "internal",
      "cache": {
        "key": "pods-${hash:ios/Podfile.lock}"
      },
      "ios": {
        "resourceClass": "m-medium",
        "image": "sdk-53"
      },
      "channel": "payments"
    },
    "production": {
      "ios": {
        "resourceClass": "m-medium",
        "image": "sdk-53"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
